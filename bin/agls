#!/usr/bin/env bash
# ==============================================================================
# agls - Agent Sessions CLI
# List, inspect, search, resume, update, and uninstall AI agent sessions
# Supports: Claude Code, Antigravity IDE / CLI, OpenCode, Codex, Pi / OMP / Prime,
#           Cline / Roo Code, GitHub Copilot CLI, Cursor
# ==============================================================================

set -euo pipefail

VERSION="1.0.0"

# Resolve script directory to load libraries
SOURCE="${BASH_SOURCE[0]}"
while [[ -h "$SOURCE" ]]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)"

# Load library components
source "$ROOT_DIR/lib/common.sh"
source "$ROOT_DIR/lib/claude.sh"
source "$ROOT_DIR/lib/antigravity.sh"
source "$ROOT_DIR/lib/opencode.sh"
source "$ROOT_DIR/lib/codex.sh"
source "$ROOT_DIR/lib/pi.sh"
source "$ROOT_DIR/lib/cline.sh"
source "$ROOT_DIR/lib/copilot.sh"
source "$ROOT_DIR/lib/cursor.sh"

show_help() {
    cat << EOF
${COLOR_BOLD}agls${COLOR_RESET} - AI Agent Session Manager (v${VERSION})

${COLOR_BOLD}USAGE:${COLOR_RESET}
    agls [COMMAND] [OPTIONS] [WORKSPACE_PATH]

${COLOR_BOLD}COMMANDS:${COLOR_RESET}
    update                Update agls to latest version from repository
    uninstall             Remove agls symlinks and shell completions

${COLOR_BOLD}ARGUMENTS:${COLOR_RESET}
    WORKSPACE_PATH        Target workspace directory (default: current directory '.')

${COLOR_BOLD}OPTIONS:${COLOR_RESET}
    -p, --page <number>   Page number to display (default: 1)
    -n, --limit <number>  Number of sessions per page (default: 20)
    -a, --all             List sessions across all workspaces
    --agent, -g <name>    Filter by agent provider: claude | antigravity | opencode | codex | pi | cline | copilot | cursor | all
    -s, --search <query>  Filter sessions containing keyword in prompt or summary
    --json                Output results as JSON
    --show, -i [ID|NUM]   Inspect transcript for a session (by ID, prefix, or table row #)
    --resume, -r [ID|NUM] Resume session (by ID, prefix, or table row #)
    -y, --yes             Auto-confirm prompts (for uninstall/update)
    -v, --version         Show version information
    -h, --help            Show this help message

${COLOR_BOLD}PAGINATION & RESUMING:${COLOR_RESET}
    agls                          # View page 1
    agls -p 2                     # Go to page 2
    agls -p 3 -n 10               # Page 3 with 10 items per page
    agls -a                       # View sessions from all workspaces
    agls -s "migration"           # Search for prompts matching "migration"
    agls -i 3                     # Inspect transcript of row #3 from last view
    agls -r 3                     # Resume session #3 from last view

${COLOR_BOLD}SUPPORTED AGENTS:${COLOR_RESET}
    • Claude Code (Anthropic)
    • Antigravity IDE & CLI (Google DeepMind)
    • Codex (OpenAI)
    • OpenCode
    • Pi Agent / OMP / Prime Agent
    • Cline & Roo Code
    • GitHub Copilot CLI
    • Cursor IDE Transcripts
EOF
}

show_version() {
    echo "agls version ${VERSION}"
}

update_agls() {
    echo -e "${COLOR_BOLD}Checking for updates to agls...${COLOR_RESET}"
    
    if [[ ! -d "$ROOT_DIR/.git" ]]; then
        echo -e "${COLOR_RED}Error: agls was not installed via Git repository.${COLOR_RESET}" >&2
        echo "To update, please re-run the installation script:" >&2
        echo "  curl -fsSL https://raw.githubusercontent.com/elhayat14/agent-sessions/main/install.sh | bash" >&2
        exit 1
    fi

    local current_branch
    current_branch="$(git -C "$ROOT_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main")"
    
    echo -e "${COLOR_DIM}Fetching tags and releases from repository...${COLOR_RESET}"
    git -C "$ROOT_DIR" fetch --tags --force --quiet origin

    local latest_tag
    latest_tag="$(git -C "$ROOT_DIR" describe --tags "$(git -C "$ROOT_DIR" rev-list --tags --max-count=1 2>/dev/null)" 2>/dev/null || true)"

    if [[ -n "$latest_tag" ]]; then
        echo -e "${COLOR_DIM}Switching to latest release tag (${latest_tag})...${COLOR_RESET}"
        git -C "$ROOT_DIR" checkout --quiet "$latest_tag"
        echo -e "${COLOR_GREEN}✓ Checked out release tag: ${latest_tag}${COLOR_RESET}"
    else
        echo -e "${COLOR_DIM}Pulling latest changes on branch ${current_branch}...${COLOR_RESET}"
        git -C "$ROOT_DIR" pull --quiet origin "$current_branch"
    fi

    echo -e "${COLOR_DIM}Re-applying symlinks and completions...${COLOR_RESET}"
    "$ROOT_DIR/install.sh" --update >/dev/null 2>&1 || true

    echo -e "${COLOR_BOLD}${COLOR_GREEN}✓ agls is up to date!${COLOR_RESET}"
    exit 0
}

uninstall_agls() {
    local auto_yes="${1:-false}"

    echo -e "${COLOR_BOLD}${COLOR_RED}=== agls Uninstaller ===${COLOR_RESET}"
    echo "This will remove the agls symlink and configuration from your system."
    echo ""

    if [[ "$auto_yes" != "true" ]]; then
        read -r -p "Are you sure you want to uninstall agls? [y/N] " response
        case "$response" in
            [yY][eE][sS]|[yY])
                ;;
            *)
                echo "Uninstallation cancelled."
                exit 0
                ;;
        esac
    fi

    local bin_dirs=("/usr/local/bin" "$HOME/.local/bin" "$HOME/bin" "$HOME/.agent-sessions/bin")
    for bdir in "${bin_dirs[@]}"; do
        if [[ -L "$bdir/agls" ]]; then
            rm -f "$bdir/agls"
            echo -e "${COLOR_DIM}Removed symlink: $bdir/agls${COLOR_RESET}"
        fi
    done

    rm -rf "$HOME/.cache/agls" "$HOME/.config/agls" 2>/dev/null || true

    echo ""
    echo -e "${COLOR_BOLD}${COLOR_GREEN}✓ agls has been successfully uninstalled.${COLOR_RESET}"
    exit 0
}

# Parse Command Line Arguments
TARGET_WORKSPACE=""
MATCH_ALL=false
AGENT_FILTER="all"
SEARCH_QUERY=""
OUTPUT_JSON=false
ACTION="list"
TARGET_SESSION_ID=""
AUTO_CONFIRM=false
PAGE=1
LIMIT=20
HAS_EXPLICIT_FILTER=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        update)
            update_agls
            ;;
        uninstall)
            ACTION="uninstall"
            shift
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        -v|--version)
            show_version
            exit 0
            ;;
        -a|--all)
            MATCH_ALL=true
            HAS_EXPLICIT_FILTER=true
            shift
            ;;
        -p|--page)
            PAGE="${2:-1}"
            shift 2
            ;;
        -n|--limit)
            LIMIT="${2:-20}"
            shift 2
            ;;
        --agent|-g)
            AGENT_FILTER="$(echo "${2:-all}" | tr '[:upper:]' '[:lower:]')"
            HAS_EXPLICIT_FILTER=true
            shift 2
            ;;
        -s|--search)
            SEARCH_QUERY="$2"
            HAS_EXPLICIT_FILTER=true
            shift 2
            ;;
        --json)
            OUTPUT_JSON=true
            shift
            ;;
        -i|--show)
            ACTION="show"
            if [[ $# -gt 1 && ! "$2" =~ ^- ]]; then
                TARGET_SESSION_ID="$2"
                shift 2
            else
                shift
            fi
            ;;
        -r|--resume)
            ACTION="resume"
            if [[ $# -gt 1 && ! "$2" =~ ^- ]]; then
                TARGET_SESSION_ID="$2"
                shift 2
            else
                shift
            fi
            ;;
        -y|--yes)
            AUTO_CONFIRM=true
            shift
            ;;
        -*)
            echo "${COLOR_RED}Unknown option: $1${COLOR_RESET}" >&2
            echo "Use 'agls --help' for usage instructions." >&2
            exit 1
            ;;
        *)
            if [[ -z "$TARGET_WORKSPACE" ]]; then
                TARGET_WORKSPACE="$1"
                HAS_EXPLICIT_FILTER=true
            fi
            shift
            ;;
    esac
done

NORMALIZED_WORKSPACE="$(normalize_path "${TARGET_WORKSPACE:-.}")"

# Collect all session JSON lines
RAW_RECORDS=()

if [[ "$AGENT_FILTER" == "all" || "$AGENT_FILTER" == "claude" ]]; then
    while IFS= read -r line; do
        [[ -n "$line" ]] && RAW_RECORDS+=("$line")
    done < <(list_claude_sessions "$NORMALIZED_WORKSPACE" "$MATCH_ALL" 2>/dev/null || true)
fi

if [[ "$AGENT_FILTER" == "all" || "$AGENT_FILTER" == "antigravity" || "$AGENT_FILTER" == "agy" || "$AGENT_FILTER" == "gemini" ]]; then
    while IFS= read -r line; do
        [[ -n "$line" ]] && RAW_RECORDS+=("$line")
    done < <(list_antigravity_sessions "$NORMALIZED_WORKSPACE" "$MATCH_ALL" 2>/dev/null || true)
fi

if [[ "$AGENT_FILTER" == "all" || "$AGENT_FILTER" == "opencode" ]]; then
    while IFS= read -r line; do
        [[ -n "$line" ]] && RAW_RECORDS+=("$line")
    done < <(list_opencode_sessions "$NORMALIZED_WORKSPACE" "$MATCH_ALL" 2>/dev/null || true)
fi

if [[ "$AGENT_FILTER" == "all" || "$AGENT_FILTER" == "codex" ]]; then
    while IFS= read -r line; do
        [[ -n "$line" ]] && RAW_RECORDS+=("$line")
    done < <(list_codex_sessions "$NORMALIZED_WORKSPACE" "$MATCH_ALL" 2>/dev/null || true)
fi

if [[ "$AGENT_FILTER" == "all" || "$AGENT_FILTER" == "pi" || "$AGENT_FILTER" == "omp" || "$AGENT_FILTER" == "prime" ]]; then
    while IFS= read -r line; do
        [[ -n "$line" ]] && RAW_RECORDS+=("$line")
    done < <(list_pi_sessions "$NORMALIZED_WORKSPACE" "$MATCH_ALL" 2>/dev/null || true)
fi

if [[ "$AGENT_FILTER" == "all" || "$AGENT_FILTER" == "cline" || "$AGENT_FILTER" == "roo" ]]; then
    while IFS= read -r line; do
        [[ -n "$line" ]] && RAW_RECORDS+=("$line")
    done < <(list_cline_sessions "$NORMALIZED_WORKSPACE" "$MATCH_ALL" 2>/dev/null || true)
fi

if [[ "$AGENT_FILTER" == "all" || "$AGENT_FILTER" == "copilot" ]]; then
    while IFS= read -r line; do
        [[ -n "$line" ]] && RAW_RECORDS+=("$line")
    done < <(list_copilot_sessions "$NORMALIZED_WORKSPACE" "$MATCH_ALL" 2>/dev/null || true)
fi

if [[ "$AGENT_FILTER" == "all" || "$AGENT_FILTER" == "cursor" ]]; then
    while IFS= read -r line; do
        [[ -n "$line" ]] && RAW_RECORDS+=("$line")
    done < <(list_cursor_sessions "$NORMALIZED_WORKSPACE" "$MATCH_ALL" 2>/dev/null || true)
fi

# Export environment variables for Python processing
export RAW_DATA_JSON="$(printf "%s\n" "${RAW_RECORDS[@]:-}")"
export SEARCH_QUERY_ENV="$SEARCH_QUERY"
export PAGE_ENV="$PAGE"
export LIMIT_ENV="$LIMIT"
export OUTPUT_JSON_ENV="$OUTPUT_JSON"
export TARGET_WS_ENV="$NORMALIZED_WORKSPACE"
export MATCH_ALL_ENV="$MATCH_ALL"
export ACTION_ENV="$ACTION"
export TARGET_ID_ENV="$TARGET_SESSION_ID"
export HAS_EXPLICIT_FILTER_ENV="$HAS_EXPLICIT_FILTER"
export AGENT_FILTER_ENV="$AGENT_FILTER"

# If Python is available, execute structured handler
if command -v python3 &>/dev/null; then
    RESOLVED_ACTION="$(python3 - << 'PY_EOF'
import json, os, sys, datetime

raw_input = os.environ.get('RAW_DATA_JSON', '').strip()
search_q = os.environ.get('SEARCH_QUERY_ENV', '').lower()
page = max(1, int(os.environ.get('PAGE_ENV', '1')))
limit = max(1, int(os.environ.get('LIMIT_ENV', '20')))
output_json = (os.environ.get('OUTPUT_JSON_ENV', 'false').lower() == 'true')
target_ws = os.environ.get('TARGET_WS_ENV', '')
match_all = (os.environ.get('MATCH_ALL_ENV', 'false').lower() == 'true')
action = os.environ.get('ACTION_ENV', 'list')
target_id_param = os.environ.get('TARGET_ID_ENV', '').strip()
has_explicit_filter = (os.environ.get('HAS_EXPLICIT_FILTER_ENV', 'false').lower() == 'true')
agent_filter = os.environ.get('AGENT_FILTER_ENV', 'all')

records = []
if raw_input:
    for line in raw_input.split('\n'):
        line = line.strip()
        if not line:
            continue
        try:
            r = json.loads(line)
            if search_q:
                combined = (str(r.get('id', '')) + ' ' + str(r.get('prompt', '')) + ' ' + str(r.get('agent', '')) + ' ' + str(r.get('workspace', ''))).lower()
                if search_q not in combined:
                    continue
            records.append(r)
        except Exception:
            continue

def parse_ts(val):
    if not val:
        return 0
    s = str(val).strip()
    if s.isdigit():
        n = int(s)
        if n > 1e11:  # ms
            return n // 1000
        return n
    try:
        s = s.replace('Z', '+00:00')
        dt = datetime.datetime.fromisoformat(s)
        return int(dt.timestamp())
    except Exception:
        return 0

# Sort by recency descending
records.sort(key=lambda x: parse_ts(x.get('timestamp')), reverse=True)

# State cache directory
cache_dir = os.path.expanduser('~/.cache/agls')
last_view_path = os.path.join(cache_dir, 'last_view.json')

# State cache functions to persist last rendered view
def save_last_view(records_list):
    try:
        os.makedirs(cache_dir, exist_ok=True)
        data = {
            'target_ws': target_ws,
            'agent_filter': agent_filter,
            'timestamp': int(datetime.datetime.now().timestamp()),
            'rows': {str(idx + 1): rec for idx, rec in enumerate(records_list)}
        }
        with open(last_view_path, 'w', encoding='utf-8') as f:
            json.dump(data, f)
    except Exception:
        pass

def load_cached_row(num_or_prefix):
    if not os.path.isfile(last_view_path):
        return None
    try:
        with open(last_view_path, 'r', encoding='utf-8') as f:
            data = json.load(f)
        rows = data.get('rows', {})
        # 1. Exact numeric row lookup
        if str(num_or_prefix) in rows:
            return rows[str(num_or_prefix)]
        # 2. Session ID / prefix lookup in cached view
        for _, rec in rows.items():
            if rec.get('id', '') == num_or_prefix:
                return rec
        for _, rec in rows.items():
            if rec.get('id', '').lower().startswith(str(num_or_prefix).lower()):
                return rec
    except Exception:
        pass
    return None

# ANSI Colors
RESET = '\033[0m'
BOLD = '\033[1m'
DIM = '\033[2m'
ORANGE = '\033[38;5;208m'
CYAN = '\033[38;5;51m'
GREEN = '\033[38;5;46m'
BLUE = '\033[38;5;39m'
PURPLE = '\033[38;5;141m'
YELLOW = '\033[38;5;226m'
GRAY = '\033[38;5;244m'
RED = '\033[38;5;196m'

def format_time(ts_val):
    sec = parse_ts(ts_val)
    if sec <= 0:
        return '-'
    now = int(datetime.datetime.now().timestamp())
    diff = max(0, now - sec)
    if diff < 60:
        return f'{diff}s ago'
    elif diff < 3600:
        return f'{diff // 60}m ago'
    elif diff < 86400:
        return f'{diff // 3600}h ago'
    elif diff < 604800:
        return f'{diff // 86400}d ago'
    else:
        dt = datetime.datetime.fromtimestamp(sec)
        return dt.strftime('%Y-%m-%d')

def agent_badge(name):
    n = name.lower()
    if 'claude' in n:
        return f'{ORANGE}Claude Code{RESET}'
    elif 'antigravity' in n:
        return f'{CYAN}Antigravity{RESET}'
    elif 'opencode' in n:
        return f'{GREEN}OpenCode{RESET}'
    elif 'codex' in n:
        return f'{BLUE}Codex{RESET}'
    elif 'pi' in n or 'omp' in n or 'prime' in n:
        return f'{PURPLE}{name}{RESET}'
    elif 'cline' in n or 'roo' in n:
        return f'{CYAN}Cline{RESET}'
    elif 'copilot' in n:
        return f'{PURPLE}Copilot{RESET}'
    elif 'cursor' in n:
        return f'{BLUE}Cursor{RESET}'
    return f'{YELLOW}{name}{RESET}'

def resolve_session(query):
    if not query:
        return None
    # If the user ran a simple 'agls -r <#>' without explicit filters, check last viewed table first
    if not has_explicit_filter:
        cached = load_cached_row(query)
        if cached:
            return cached

    if query.isdigit():
        idx = int(query) - 1
        if 0 <= idx < len(records):
            return records[idx]
    for r in records:
        if r.get('id', '') == query:
            return r
    for r in records:
        if r.get('id', '').lower().startswith(query.lower()):
            return r
    
    # Fallback to cache
    cached = load_cached_row(query)
    if cached:
        return cached
    return None

if action in ('show', 'resume'):
    target_rec = None
    if target_id_param:
        target_rec = resolve_session(target_id_param)
    elif records:
        verb = 'resume' if action == 'resume' else 'inspect'
        print(f'\n{BOLD}Select a session to {verb}:{RESET}')
        for i, r in enumerate(records[:15], 1):
            print(f'  {CYAN}[{i}]{RESET} {r.get("id", "")} ({r.get("agent", "")}, {format_time(r.get("timestamp"))}) - {r.get("prompt", "")[:40]}')
        try:
            choice = input(f'\nEnter number (1-{min(15, len(records))}): ').strip()
            target_rec = resolve_session(choice)
        except Exception:
            sys.exit(0)

    if not target_rec:
        print(f'{RED}Error: Session \"{target_id_param}\" not found.{RESET}', file=sys.stderr)
        sys.exit(1)

    print(f'DISPATCH:{action}:{target_rec["agent"]}:{target_rec["id"]}:{target_rec.get("workspace", "")}')
    sys.exit(0)

# Save current view to cache so subsequent 'agls -r #' commands match exactly
save_last_view(records)

# Pagination Calculation
total_found = len(records)
total_pages = max(1, (total_found + limit - 1) // limit)
page = min(page, total_pages)
start_idx = (page - 1) * limit
end_idx = min(start_idx + limit, total_found)
page_records = records[start_idx:end_idx]

if output_json:
    print(json.dumps(page_records, indent=2))
    sys.exit(0)

if not records:
    scope = 'all workspaces' if match_all else f'workspace: {BOLD}{target_ws}{RESET}'
    print(f'\n{GRAY}No active or past agent sessions found for {scope}.{RESET}\n')
    sys.exit(0)

scope_str = 'All Workspaces' if match_all else target_ws
page_indicator = f'Page {page}/{total_pages}' if total_pages > 1 else ''
print(f'\n{BOLD}AGENT SESSIONS{RESET} {DIM}(Workspace: {scope_str}) {page_indicator}{RESET}\n')

col_idx_w = 7
col_id_w = 38
col_agent_w = 13
col_age_w = 11
col_turns_w = 7

header_line = (
    f'{BOLD}{GRAY}'
    f'{"#":<{col_idx_w}} '
    f'{"SESSION ID":<{col_id_w}} '
    f'{"AGENT":<{col_agent_w}} '
    f'{"UPDATED":<{col_age_w}} '
    f'{"TURNS":<{col_turns_w}}'
    f'{RESET}'
)
separator = f'{DIM}{"─" * 80}{RESET}'

print(header_line)
print(separator)

home_dir = os.path.expanduser('~')

for offset, r in enumerate(page_records):
    abs_idx = start_idx + offset + 1
    sid = r.get('id', '')
    if len(sid) > col_id_w:
        sid = sid[:col_id_w - 3] + '...'
    agent_raw = r.get('agent', '')
    badge = agent_badge(agent_raw)
    age = format_time(r.get('timestamp'))
    turns = str(r.get('turns', 1))
    
    ws = r.get('workspace', '').strip()
    if ws and ws.startswith(home_dir):
        ws_short = '~' + ws[len(home_dir):]
    elif ws:
        ws_short = ws
    else:
        ws_short = '(unknown workspace)'
    
    prompt = r.get('prompt', '').replace('\n', ' ').strip()
    if len(prompt) > 80:
        prompt = prompt[:77] + '...'
    
    agent_pad = ' ' * max(0, col_agent_w - len(agent_raw))
    idx_str = f'[{abs_idx}]'
    
    # Line 1: Session ID & metadata
    print(
        f'{YELLOW}{idx_str:<{col_idx_w}}{RESET} '
        f'{CYAN}{sid:<{col_id_w}}{RESET} '
        f'{badge}{agent_pad} '
        f'{DIM}{age:<{col_age_w}}{RESET} '
        f'{turns:<{col_turns_w}}'
    )
    # Line 2: Workspace path & prompt summary
    print(f'       {DIM}📂 {ws_short}{RESET}  {DIM}•{RESET}  \"{prompt}\"')

print(separator)

# Navigation summary in footer
if total_pages > 1:
    range_str = f'{start_idx + 1}-{end_idx} of {total_found}'
    nav_hints = []
    if page < total_pages:
        nav_hints.append(f'Next: {BOLD}agls -p {page + 1}{RESET}')
    if page > 1:
        nav_hints.append(f'Prev: {BOLD}agls -p {page - 1}{RESET}')
    
    nav_str = '  |  '.join(nav_hints)
    print(f'{DIM}Showing {range_str} sessions (Page {page}/{total_pages}).{RESET}  {nav_str}')
else:
    print(f'{DIM}Showing {total_found} of {total_found} sessions.{RESET}')

print(f'{DIM}Quick Resume: {BOLD}agls -r <#|SESSION_ID>{RESET}  {DIM}Inspect: {BOLD}agls -i <#|SESSION_ID>{RESET}\n')
PY_EOF
)"

    if [[ "$RESOLVED_ACTION" == DISPATCH:* ]]; then
        IFS=':' read -r _ ACT AGENT_NAME SID SWS <<< "$RESOLVED_ACTION"
        
        if [[ "$ACT" == "show" ]]; then
            if [[ "$AGENT_NAME" == *"Claude"* ]]; then
                show_claude_session "$SID"
            elif [[ "$AGENT_NAME" == *"Antigravity"* ]]; then
                show_antigravity_session "$SID"
            elif [[ "$AGENT_NAME" == *"OpenCode"* ]]; then
                show_opencode_session "$SID"
            elif [[ "$AGENT_NAME" == *"Codex"* ]]; then
                show_codex_session "$SID"
            elif [[ "$AGENT_NAME" == *"Pi"* || "$AGENT_NAME" == *"OMP"* || "$AGENT_NAME" == *"Prime"* ]]; then
                show_pi_session "$SID"
            elif [[ "$AGENT_NAME" == *"Cline"* ]]; then
                show_cline_session "$SID"
            elif [[ "$AGENT_NAME" == *"Copilot"* ]]; then
                show_copilot_session "$SID"
            elif [[ "$AGENT_NAME" == *"Cursor"* ]]; then
                show_cursor_session "$SID"
            else
                echo "${COLOR_RED}Unknown agent: $AGENT_NAME${COLOR_RESET}"
            fi
            exit 0
        fi

        if [[ "$ACT" == "resume" ]]; then
            echo ""
            echo "${COLOR_BOLD}Resuming ${AGENT_NAME} Session:${COLOR_RESET} ${COLOR_CYAN}${SID}${COLOR_RESET}"
            if [[ -n "$SWS" && "$SWS" != "$PWD" ]]; then
                echo "${COLOR_DIM}Workspace: ${SWS}${COLOR_RESET}"
            fi

            if [[ "$AGENT_NAME" == *"Claude"* ]]; then
                cmd="claude --resume $SID"
                echo "Execute command: ${COLOR_BOLD}${COLOR_GREEN}${cmd}${COLOR_RESET}"
                echo ""
                if [[ -t 0 && -n "$SWS" && -d "$SWS" ]]; then
                    cd "$SWS"
                fi
                if command -v claude &>/dev/null; then
                    exec claude --resume "$SID"
                fi
                exit 0
            elif [[ "$AGENT_NAME" == *"Antigravity"* ]]; then
                cmd="agy --conversation=$SID"
                echo "Execute command: ${COLOR_BOLD}${COLOR_GREEN}${cmd}${COLOR_RESET}"
                echo ""
                if command -v agy &>/dev/null; then
                    exec agy "--conversation=$SID"
                fi
                exit 0
            elif [[ "$AGENT_NAME" == *"OpenCode"* ]]; then
                cmd="opencode -s $SID"
                echo "Execute command: ${COLOR_BOLD}${COLOR_GREEN}${cmd}${COLOR_RESET}"
                echo ""
                if command -v opencode &>/dev/null; then
                    exec opencode -s "$SID"
                fi
                exit 0
            elif [[ "$AGENT_NAME" == *"Codex"* ]]; then
                cmd="codex resume $SID"
                echo "Execute command: ${COLOR_BOLD}${COLOR_GREEN}${cmd}${COLOR_RESET}"
                echo ""
                if command -v codex &>/dev/null; then
                    exec codex resume "$SID"
                fi
                exit 0
            elif [[ "$AGENT_NAME" == *"Pi"* ]]; then
                cmd="pi --session $SID"
                echo "Execute command: ${COLOR_BOLD}${COLOR_GREEN}${cmd}${COLOR_RESET}"
                echo ""
                if command -v pi &>/dev/null; then
                    exec pi --session "$SID"
                fi
                exit 0
            elif [[ "$AGENT_NAME" == *"Cline"* ]]; then
                cmd="cline --task $SID"
                echo "Execute command: ${COLOR_BOLD}${COLOR_GREEN}${cmd}${COLOR_RESET}"
                echo ""
                if command -v cline &>/dev/null; then
                    exec cline --task "$SID"
                fi
                exit 0
            elif [[ "$AGENT_NAME" == *"Copilot"* ]]; then
                cmd="copilot --resume $SID"
                echo "Execute command: ${COLOR_BOLD}${COLOR_GREEN}${cmd}${COLOR_RESET}"
                echo ""
                if command -v copilot &>/dev/null; then
                    exec copilot --resume "$SID"
                fi
                exit 0
            elif [[ "$AGENT_NAME" == *"Cursor"* ]]; then
                cmd="cursor $SWS"
                echo "Execute command: ${COLOR_BOLD}${COLOR_GREEN}${cmd}${COLOR_RESET}"
                echo ""
                if command -v cursor &>/dev/null; then
                    exec cursor "$SWS"
                fi
                exit 0
            fi
        fi
    else
        echo "$RESOLVED_ACTION"
    fi
else
    echo "Found ${#RAW_RECORDS[@]} session records."
    for r in "${RAW_RECORDS[@]}"; do
        echo "$r"
    done
fi
